rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email()    { return request.auth.token.email.lower(); }
    function isAdmin()  { return signedIn() && email() == 'bg.manu6@gmail.com'; }
    function isBearer() { return signedIn() && exists(/databases/$(database)/documents/users/$(email())); }
    match /{collection}/{doc} {
      allow read:  if isAdmin() || isBearer();
      allow write: if isAdmin();
    }
    // Each office bearer may record only their own "last seen" time
    match /seen/{who} {
      allow create, update: if isBearer() && email() == who
        && request.resource.data.keys().hasOnly(['at', 'email', 'name']);
    }
    // Payment vouchers: anyone with the secret link can open that one voucher
    // and sign it once. They cannot change the amount, name or anything else.
    match /vouchers/{token} {
      allow get: if true;
      allow update: if resource.data.signed == false
        && request.resource.data.signed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signed', 'sig', 'signedAt', 'signerName'])
        && request.resource.data.sig is string && request.resource.data.sig.size() < 200000
        && request.resource.data.signerName is string && request.resource.data.signerName.size() < 80;
    }
  }
}
